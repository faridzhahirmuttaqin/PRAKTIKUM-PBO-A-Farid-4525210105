{
    "name": "univpancasila/perpustakaan-sesi11",
    "description": "Praktikum PBO pertemuan 11 - collections, generics, dan unit test",
    "type": "project",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Perpustakaan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Perpustakaan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
